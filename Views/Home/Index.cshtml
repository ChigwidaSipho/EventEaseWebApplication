@{
    ViewData["Title"] = "Home Page";
}

<style>

    .dashboard-header {
        background: linear-gradient(135deg,#1e293b,#0f172a);
        color: white;
        padding: 60px; 
        border-radius: 12px;
        margin-top: 20px;
    }

        .dashboard-header h1 {
            font-weight: 700;
        }

    .stats-card {
        padding: 25px;
        border-radius: 10px;
        background: white;
        box-shadow: 0 6px 20px rgba(0,0,0,0.1);
        text-align: center;
        transition: .3s;
    }

        .stats-card:hover {
            transform: translateY(-6px);
        }

    .action-card {
        padding: 35px;
        border-radius: 12px;
        background: #f8fafc;
        text-align: center;
        border: 1px solid #e2e8f0;
    }

        .action-card h3 {
            margin-bottom: 15px;
        }

</style>


<div class="dashboard-header">
    <h1>EventEase Dashboard</h1>
    <p>Manage events, venues and bookings from one place.</p>
</div>


<div class="container mt-5">

    <div class="row text-center mb-5">

        <div class="col-md-4">
            <div class="stats-card">
                <h2>📅</h2>
                <h3>Events</h3>
                <p>Manage upcoming and past events</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stats-card">
                <h2>🏛️</h2>
                <h3>Venues</h3>
                <p>View and maintain venue information</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stats-card">
                <h2>📝</h2>
                <h3>Bookings</h3>
                <p>Track all venue bookings</p>
            </div>
        </div>

    </div>


    <div class="row">

        <div class="col-md-4">
            <div class="action-card">
                <h3>Manage Events</h3>
                <a asp-controller="Event" asp-action="Index" class="btn btn-primary">Open Events</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="action-card">
                <h3>Manage Venues</h3>
                <a asp-controller="Venue" asp-action="Index" class="btn btn-info">Open Venues</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="action-card">
                <h3>Manage Bookings</h3>
                <a asp-controller="Booking" asp-action="Index" class="btn btn-success">Open Bookings</a>
            </div>
        </div>

    </div>

</div>