@{
    ViewData["Title"] = "Privacy Policy";
}

<style>

    .privacy-container {
        max-width: 900px;
        margin: auto;
        margin-top: 40px;
    }

    .privacy-header {
        text-align: center;
        margin-bottom: 40px;
    }

        .privacy-header h1 {
            font-weight: 700;
        }

    .privacy-section {
        margin-bottom: 30px;
    }

        .privacy-section h3 {
            margin-bottom: 10px;
            font-weight: 600;
        }

</style>

<div class="privacy-container">

    <div class="privacy-header">
        <h1>Privacy Policy</h1>
        <p>How EventEase collects, uses, and protects your information.</p>
    </div>

    <div class="privacy-section">
        <h3>Information We Collect</h3>
        <p>
            EventEase may collect information related to events, venues, and bookings
            entered by users into the system. This information is stored securely in
            the database and is used only for managing event operations.
        </p>
    </div>

    <div class="privacy-section">
        <h3>How We Use Your Information</h3>
        <p>
            The information stored in EventEase is used to manage event scheduling,
            venue availability, and booking records. This ensures smooth coordination
            between event planners and venue management.
        </p>
    </div>

    <div class="privacy-section">
        <h3>Data Security</h3>
        <p>
            EventEase implements appropriate security measures to protect stored data
            from unauthorized access. Only authorized users of the system should have
            access to event and booking information.
        </p>
    </div>

    <div class="privacy-section">
        <h3>System Usage</h3>
        <p>
            This application is designed for event management purposes. Users are
            responsible for ensuring that any information entered into the system
            is accurate and appropriate.
        </p>
    </div>

</div>