@model IEnumerable<EventEase.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"> Bookings</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            + New Booking
        </a>
    </div

    <div class="card shadow-lg border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Venue</th>
                        <th>Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @Html.DisplayFor(modelItem => item.Event.EventName)
                            </td>
                            <td>
                                📍 @Html.DisplayFor(modelItem => item.Venue.Location)
                            </td>
                            <td>
                                @item.BookingDate.ToString("dd MMM yyyy")
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.BookingID"
                                       class="btn btn-sm btn-warning me-1">
                                    Edit
                                </a>

                                <a asp-action="Details" asp-route-id="@item.BookingID"
                                       class="btn btn-sm btn-info text-white me-1">
                                    Details
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.BookingID"
                                       class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>