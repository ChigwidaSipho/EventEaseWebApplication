@model IEnumerable<EventEase.Models.BookingViewModel>

@{
    ViewData["Title"] = "Bookings";
}

<div class="container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Bookings</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            + New Booking
        </a>
    </div>

    <!-- 🔍 SEARCH BOX -->
    <form asp-action="Index" method="get" class="mb-3">
        <div class="form-group">
            <input type="text"
                   name="searchString"
                   class="form-control"
                   placeholder="Search by Booking ID or Event Name..."
                   value="@Context.Request.Query["searchString"]" />
        </div>

        <button type="submit" class="btn btn-primary mt-2">
            Search
        </button>
    </form>

    <!-- ✅ SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- ❌ ERROR MESSAGES -->
    @if (!ViewData.ModelState.IsValid)
    {
        foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div class="alert alert-danger">
                @error.ErrorMessage
            </div>
        }
    }

    <!-- 📊 BOOKING TABLE (VIEW MODEL BASED) -->
    <div class="card shadow-lg border-0">
        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Booking ID</th>
                        <th>Event Name</th>
                        <th>Event Date</th>
                        <th>Venue Name</th>
                        <th>Location</th>
                        <th>Capacity</th>
                        <th>Booking Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>@booking.BookingID</td>
                            <td>@booking.EventName</td>
                            <td>@booking.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@booking.VenueName</td>
                            <td>@booking.Location</td>
                            <td>@booking.Capacity</td>
                            <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>

                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@booking.BookingID"
                                       class="btn btn-sm btn-warning me-1">
                                    Edit
                                </a>

                                <a asp-action="Details" asp-route-id="@booking.BookingID"
                                       class="btn btn-sm btn-info text-white me-1">
                                    Details
                                </a>

                                <a asp-action="Delete" asp-route-id="@booking.BookingID"
                                       class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>